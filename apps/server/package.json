{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "test": "vitest run --passWithNoTests",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@mrconfetti-ecommerce/api": "workspace:*",
    "@mrconfetti-ecommerce/auth": "workspace:*",
    "@mrconfetti-ecommerce/db": "workspace:*",
    "@mrconfetti-ecommerce/env": "workspace:*",
    "@scalar/hono-api-reference": "^0.11.16",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "catalog:",
    "typesense": "^3.1.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@mrconfetti-ecommerce/config": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "jsdom": "catalog:",
    "tsdown": "^0.22.3",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
